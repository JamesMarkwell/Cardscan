{
  "expo": {
    "name": "CardScan",
    "slug": "cardscan",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "cardscan",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0E14"
    },
    "android": {
      "package": "com.cardscan.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.VIBRATE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0B0E14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cardscan.app"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "CardScan uses the camera to identify trading cards. Images are processed on your phone and are not uploaded."
        }
      ],
      "./plugins/withAndroidReleaseSize"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
